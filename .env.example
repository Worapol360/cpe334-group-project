# FeedbackLoop / TokTickIT — environment template (L5-02).
# Copy to ".env" (or server/.env for the API) and fill in your own values.
# NEVER commit a real .env file. Placeholders are CHANGE_ME only.
# Local defaults: Postgres on host port 5433, API on PORT=8081.

# ---- App -------------------------------------------------------------------
APP_ENV=development          # runtime environment: development | production (not a secret)
PORT=8081                    # API listen port; local default 8081, Cloud Run injects PORT (not a secret)
LOG_LEVEL=info               # log verbosity: silent | error | warn | info (not a secret)
APP_VERSION=dev              # version reported by /api/health; unset falls back to "dev" (not a secret)
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated allowed browser origins (not a secret)

# ---- Session / cookie ------------------------------------------------------
SESSION_TTL_MINUTES=60       # session lifetime in minutes (not a secret)
COOKIE_SECURE=false          # set "true" behind HTTPS (Cloud Run); session cookie Secure flag (not a secret)

# ---- Database (docker-compose creates the DB with these) -------------------
POSTGRES_USER=CHANGE_ME      # Postgres superuser name (not a secret, but environment-specific)
POSTGRES_PASSWORD=CHANGE_ME  # Postgres password — SECRET
POSTGRES_DB=CHANGE_ME        # Postgres database name (not a secret)

# ---- Database connection (must match the values above; host port 5433) -----
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5433/CHANGE_ME  # app DB URL — SECRET
DATABASE_URL_TEST=postgresql://CHANGE_ME:CHANGE_ME@localhost:5433/CHANGE_ME_test  # dedicated test DB URL — SECRET

# ---- Seed ------------------------------------------------------------------
SEED_PASSWORD=CHANGE_ME      # password for seeded demo accounts — SECRET

# ---- Client dev server -----------------------------------------------------
API_PROXY_TARGET=http://localhost:8081  # Vite dev-server proxy target for /api (not a secret)
