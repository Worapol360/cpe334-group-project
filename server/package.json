{
  "name": "feedbackloop-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:api": "vitest run --config vitest.api.config.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node src/persistence/seed.js",
    "prisma:seed": "node src/persistence/seed.js"
  },
  "prisma": {
    "seed": "node src/persistence/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
