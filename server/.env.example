# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
# ---- App ----
APP_ENV=development
PORT=8080
LOG_LEVEL=info
APP_VERSION=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Session ----
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false

# ---- Database (used by docker-compose to create the DB) ----
POSTGRES_USER=feedbackloop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=feedbackloop

# ---- Database connection (must match the values above; host port 5433, see docker-compose.yml) ----
DATABASE_URL=postgresql://feedbackloop:change-me@localhost:5433/feedbackloop
DATABASE_URL_TEST=postgresql://feedbackloop:change-me@localhost:5433/feedbackloop_test

# ---- Seed (demo accounts: owner1, owner2, respondent1, respondent2) ----
SEED_PASSWORD=change-me